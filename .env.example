# Copy this file to .env and fill in your values
# Never commit .env to version control

# Settings module — use development for local work, production on servers
DJANGO_SETTINGS_MODULE=portfolio_site_generator.settings.development

DJANGO_SECRET_KEY=your-long-random-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave blank to use SQLite locally)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# AI
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Logging (optional, defaults to INFO)
# LOG_LEVEL=DEBUG
